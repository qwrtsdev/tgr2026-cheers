---
import Layout from '../layouts/Layout.astro';
import FallingIcons from '../components/FallingIcons.astro';
---

<Layout title="ตารางอันดับ" wide>
  <FallingIcons kind="trophy" />

  <div id="loading" role="status" class="fixed inset-0 z-20 grid place-items-center bg-cream">
    <span class="size-10 animate-spin rounded-full border-4 border-coral border-t-transparent motion-reduce:animate-[spin_2s_linear_infinite]"></span>
    <span class="sr-only">กำลังโหลดอันดับ…</span>
  </div>

  <section aria-labelledby="title" class="w-full rounded-md bg-white p-7 shadow-xl shadow-ink/10">
    <p class="font-sans text-[1.2rem] font-bold text-coral">ผู้ที่ถูกชนแก้วมากที่สุด</p>
    <h1 id="title" class="mt-1 font-display text-[clamp(2.2rem,10vw,3.05rem)] leading-[1.25] font-bold">ตารางอันดับ</h1>

    <hr class="my-6 border-t-2 border-dashed border-cream-line" />

    <!-- Wide screens: podium (top 3) left, places 4-10 right. Phones: stacked. -->
    <div id="board" class="grid gap-8 md:grid-cols-2 md:gap-10">
      <ol id="podium" aria-label="อันดับ 1-3" class="grid grid-cols-3 items-end gap-2 self-end"></ol>
      <div class="md:border-l-2 md:border-dashed md:border-cream-line md:pl-10">
        <ol id="list" start="4" aria-label="อันดับ 4-10" class="flex flex-col"></ol>
        <p id="list-empty" hidden class="text-ink/60">ยังไม่มีอันดับ 4–10</p>
      </div>
    </div>
    <p id="empty" hidden class="text-lg">ยังไม่มีใครได้ชนแก้วเลย</p>
  </section>

  <a href="/" class="min-h-12 grid place-items-center rounded-md bg-ink px-4 font-semibold text-cream transition-transform focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ink md:justify-self-center md:px-16">
    กลับ
  </a>
</Layout>

<script>
  import { supabase, avatarUrl } from '../lib/supabase';

  type Row = { id: string; display_name: string; avatar_path: string | null; is_dev?: boolean; cheers: number };
  const list = document.getElementById('list')!;
  const podium = document.getElementById('podium')!;
  const empty = document.getElementById('empty')!;

  const { data, error } = await supabase.rpc('leaderboard', { n: 10 });
  const rows = (data ?? []) as Row[];

  // textContent only: names are user input
  function avatar(r: Row | undefined, size: string) {
    const pic = document.createElement(r?.avatar_path ? 'img' : 'span'); // a plain circle when there's no photo
    pic.className = `${size} shrink-0 rounded-full bg-cream object-cover`;
    if (pic instanceof HTMLImageElement) {
      pic.src = avatarUrl(r!.avatar_path!);
      pic.alt = '';
      pic.loading = 'lazy';
    }
    return pic;
  }
  function nameEl(r: Row, cls: string) {
    const name = document.createElement('span');
    name.className = `flex min-w-0 items-center gap-1.5 ${cls}`;
    const text = document.createElement('span');
    text.className = 'min-w-0 truncate font-semibold';
    text.textContent = r.display_name;
    name.append(text);
    if (r.is_dev) {
      const dev = document.createElement('span');
      dev.className = 'shrink-0 rounded bg-dev px-1.5 py-0.5 text-xs leading-none font-bold tracking-wide text-white';
      dev.textContent = 'DEV';
      name.append(dev);
    }
    return name;
  }

  // Podium: 2nd | 1st | 3rd. Taller block = higher place; blocks rise in 3rd, 2nd, 1st (global.css).
  const STEP = {
    1: { block: 'h-32 bg-gold', ring: 'ring-gold', pic: 'size-20' },
    2: { block: 'h-24 bg-silver', ring: 'ring-silver', pic: 'size-16' },
    3: { block: 'h-16 bg-bronze', ring: 'ring-bronze', pic: 'size-16' },
  } as const;
  const CUP =
    'M6 3h12v2h3v3a4 4 0 0 1-4 4h-.35A6 6 0 0 1 13 15.9V19h3v2H8v-2h3v-3.1A6 6 0 0 1 7.35 12H7a4 4 0 0 1-4-4V5h3V3Zm0 4H5v1a2 2 0 0 0 1 1.73V7Zm12 0v2.73A2 2 0 0 0 19 8V7h-1Z';

  podium.replaceChildren(
    ...([1, 2, 3] as const).map((rank) => {
      const r = rows[rank - 1];
      const s = STEP[rank];
      const li = document.createElement('li');
      li.value = rank;
      li.style.order = String([0, 2, 1, 3][rank]); // shown 2 | 1 | 3; read in order 1, 2, 3
      li.className = 'flex min-w-0 flex-col items-center gap-1.5 text-center';
      if (rank === 1) {
        // Gold cup above the winner.
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('aria-hidden', 'true');
        svg.setAttribute('class', 'size-8 fill-gold');
        const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        p.setAttribute('d', CUP);
        svg.append(p);
        li.append(svg);
      }
      const pic = avatar(r, s.pic);
      if (r) pic.classList.add('ring-4', s.ring);
      const name = r ? nameEl(r, 'w-full justify-center') : document.createElement('span');
      if (!r) name.textContent = '—';
      const count = document.createElement('span');
      count.className = 'text-sm tabular-nums text-ink/70';
      count.textContent = r ? `${r.cheers} แก้ว` : '';
      const block = document.createElement('span');
      block.setAttribute('aria-hidden', 'true');
      block.className = `podium-step mt-1 grid w-full place-items-start justify-center rounded-t-md pt-2 font-display text-3xl font-bold text-ink ${r ? s.block : `${s.block.split(' ')[0]} bg-cream-line`}`;
      block.style.setProperty('--step', String(rank));
      block.textContent = String(rank);
      li.append(pic, name, count, block);
      return li;
    }),
  );

  list.replaceChildren(...rows.slice(3).map((r, i) => {
    const li = document.createElement('li');
    li.className = 'flex items-center gap-3 border-b border-cream-line py-3 last:border-0';
    const rank = document.createElement('span');
    rank.className = 'w-8 shrink-0 font-display text-2xl font-bold text-ink/40';
    rank.textContent = String(i + 4);
    const name = nameEl(r, 'flex-1 text-lg');
    const count = document.createElement('span');
    count.className = 'shrink-0 font-semibold tabular-nums';
    count.textContent = `${r.cheers} แก้ว`;
    li.append(rank, avatar(r, 'size-9'), name, count);
    return li;
  }));
  document.getElementById('list-empty')!.hidden = rows.length > 3;

  const none = !!error || !rows.length;
  document.getElementById('board')!.hidden = none;
  if (error) empty.textContent = `โหลดอันดับไม่สำเร็จ: ${error.message}`;
  empty.hidden = !none;
  document.getElementById('loading')!.hidden = true;
</script>
